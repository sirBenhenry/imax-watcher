<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101014"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Odyssey Watch"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Cineplex seat watcher"
            android:textColor="#8A8A99"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1B1B22"
            android:padding="14dp"
            android:text="Not started yet"
            android:textColor="#E6E6F0"
            android:textSize="15sp" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Start watching" />

        <Button
            android:id="@+id/checkNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Check once now" />

        <!-- ============================ WHAT ============================ -->
        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WHAT TO WATCH" />

        <Button
            android:id="@+id/pickFilm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose film" />

        <TextView
            android:id="@+id/filmLabel"
            style="@style/ValueLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No film selected" />

        <Button
            android:id="@+id/pickTheatres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Choose cinemas" />

        <TextView
            android:id="@+id/theatreLabel"
            style="@style/ValueLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No cinemas selected" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Format" />

        <Spinner
            android:id="@+id/experience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ============================ FILTERS ============================ -->
        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FILTERS" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alert from row" />

        <Spinner
            android:id="@+id/minRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Earliest start time" />

        <Spinner
            android:id="@+id/earliest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latest start time" />

        <Spinner
            android:id="@+id/latest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How far ahead to look" />

        <Spinner
            android:id="@+id/window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/notifyOnSale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Alert when tickets first go on sale"
            android:textColor="#E6E6F0" />

        <!-- ============================ RUNTIME ============================ -->
        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RUNTIME" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check every" />

        <Spinner
            android:id="@+id/interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Disable battery optimisation" />

        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LAST SCAN" />

        <TextView
            android:id="@+id/report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="#1B1B22"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="—"
            android:textColor="#B9B9C6"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
